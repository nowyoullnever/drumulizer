{
  "name": "drumulizer",
  "version": "0.8.0",
  "description": "Offline sample-based IDM drum-loop generator foundation.",
  "author": "nowyoullnever",
  "license": "UNLICENSED",
  "private": true,
  "productName": "Drumulizer",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:onset": "vitest run onset fft preprocess detectionCandidate onsetWorker analysisUi",
    "test:slice-analysis": "vitest run sliceAnalysis",
    "test:sequencer": "vitest run sequencerScheduler sequencerPattern sequencerUi",
    "test:generator": "vitest run generator prng grammar mutation generatorEvaluation generatorUi",
    "test:idm": "vitest run probability timing ratchet reverse granular idmTransform transformEvaluation",
    "verify:onset": "npm run typecheck && npm run test:onset",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && node scripts/package-windows.mjs",
    "dist:win:builder": "electron-builder --win --x64 --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.nowyoullnever.drumulizer",
    "productName": "Drumulizer"
  }
}
